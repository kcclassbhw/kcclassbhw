{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --no-frozen-lockfile --prod=false",
  "buildCommand": "pnpm --filter @workspace/learn run build",
  "outputDirectory": "apps/learn/dist/public",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
