# Frontend — local development environment
# Windows: copy apps\learn\.env.example apps\learn\.env
# Mac/Linux: cp apps/learn/.env.example apps/learn/.env

# ── API URL ───────────────────────────────────────────────────────────────────
# Points the frontend at your local API server
VITE_API_URL=http://localhost:5000

# ── Supabase Auth (Optional but recommended) ──────────────────────────────────
# Find in your Supabase project dashboard → Project Settings → API
# Enables Supabase Auth, Google/OAuth login, and self-service password reset.
# If left empty, the app seamlessly runs using native JWT authentication.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Dev Server ────────────────────────────────────────────────────────────────
PORT=3000
BASE_PATH=/
