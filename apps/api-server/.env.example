# API Server — local development environment
# Copy this file:
#   Windows:  copy apps\api-server\.env.example apps\api-server\.env
#   Mac/Linux: cp apps/api-server/.env.example apps/api-server/.env

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# You MUST replace this with a real connection string — the server will not
# start until DATABASE_URL points to a reachable database.
#
# Option A — Neon / Supabase PostgreSQL (recommended):
#   postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# Option B — Local PostgreSQL:
#   postgresql://postgres:YOURPASSWORD@localhost:5432/kcclassbhw
DATABASE_URL=REPLACE_WITH_YOUR_CONNECTION_STRING

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Secret used to sign and verify JWT tokens. Must be a long random string (32+ chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# REQUIRED in production.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# ── Supabase Auth (Optional but recommended) ──────────────────────────────────
# Connects backend to your Supabase project for validating tokens and syncing profiles.
# Find in Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
# Alternatively anon key if service role is not used:
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Leave blank for local dev (all origins allowed in development mode).
# CORS_ORIGIN=https://kcclassbhw.com

# ── Frontend URL ──────────────────────────────────────────────────────────────
# FRONTEND_URL=http://localhost:3000

# ── YouTube Channel ───────────────────────────────────────────────────────────
# Channel ID for KC Class BHW
YOUTUBE_CHANNEL_ID=UC77kf2jXTQvRl2vV3CI8oRA

# ── eSewa Payments (optional) ─────────────────────────────────────────────────
# ESEWA_PRODUCT_CODE=YOUR_MERCHANT_CODE
# ESEWA_SECRET_KEY=YOUR_SECRET_KEY
# ESEWA_ENV=production
